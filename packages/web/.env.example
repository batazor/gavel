# Explicit runtime mode: demo never calls the network; connected requires the Router endpoint.
VITE_DATA_MODE=connected

# Public Cosmo Router endpoint used only in connected mode.
VITE_GRAPHQL_URL=http://127.0.0.1:8080/graphql

# Local MVP only. The app refuses to enable the identity switcher for another profile.
VITE_DEPLOYMENT_PROFILE=local
VITE_LOCAL_AUTH_ENABLED=true
VITE_LOCAL_AUTH_ISSUER=http://127.0.0.1:8080/default
VITE_LOCAL_AUTH_AUDIENCE=gavel-web
