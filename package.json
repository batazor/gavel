{
  "name": "gavel",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "storybook": "npm run storybook --workspace=@gavel/ui",
    "storybook:build": "npm run build-storybook --workspace=@gavel/ui",
    "ui:check": "npm run check --workspace=@gavel/ui",
    "web": "npm run dev --workspace=@gavel/web",
    "web:check": "npm run check --workspace=@gavel/web",
    "web:build": "npm run build --workspace=@gavel/web",
    "graphql:check": "wgc router compose -i contexts/bff/cosmo/supergraph.yaml -o /tmp/gavel-execution-config.json",
    "graphql:compose": "wgc router compose -i contexts/bff/cosmo/supergraph.yaml -o contexts/bff/cosmo/execution-config.json",
    "arch": "likec4 start .",
    "arch:validate": "likec4 validate .",
    "arch:build": "likec4 build . -o site --title \"Gavel — архитектура\""
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/batazor/gavel.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/batazor/gavel/issues"
  },
  "homepage": "https://github.com/batazor/gavel#readme",
  "devDependencies": {
    "likec4": "^1.60.0",
    "wgc": "^0.133.0"
  },
  "private": true
}
