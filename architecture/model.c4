model {

  // ---------- Люди ----------

  bidder = actor 'Участник торгов' {
    description 'Смотрит лоты, делает ставки, следит за ценой в реальном времени'
  }

  seller = actor 'Продавец' {
    description 'Выставляет лоты, задаёт стартовую цену и срок'
  }

  // ---------- Внешние системы ----------

  idp = external 'OAuth / OIDC провайдер' {
    description 'Внешняя аутентификация. Выдаёт JWT, мы берём только user_id (sub). Своей базы пользователей нет.'
    icon tech:oauth
  }

  observability = external 'Grafana stack' {
    description 'Tempo (traces), Mimir (metrics), Loki (logs). Принимает данные от OTel Collector.'
    icon tech:grafana
  }

  // ---------- Наша система ----------
  // Микросервисы: один bounded context = один сервис + своя БД (ADR-0004).

  gavel = system 'Gavel' {
    description 'Аукцион. Лоты, ставки, завершение торгов, определение победителя.'

    web = webapp 'Web UI' {
      technology 'Astro'
      description 'SSR + островки интерактивности. Живое обновление цены по WebSocket/SSE.'
      icon tech:astro
    }

    bff = container 'BFF' {
      technology 'Rust'
      description 'Единственная публичная точка входа. Компонует экраны, переводит команды, фан-аутит SSE. Без доменных правил (ADR-0008).'
      icon tech:rust

      routes = component 'HTTP routes' {
        description 'API для Web UI. user_id берёт из заголовков, проставленных мешем.'
      }
      composer = component 'Screen composer' {
        description 'Собирает экран лота: карточка из Catalog + цена и ставки из Auction'
      }
      sse = component 'SSE fan-out' {
        description 'GET /lots/{id}/events. Подписан на брокер, держит соединения браузеров. Last-Event-ID → дозапрос у Auction.'
      }
    }

    // ----- Bounded context: Auction -----

    auction = context 'Auction' {
      #domain
      description 'Ядро. Торги: ставки, завершение, победитель. Event sourced, инварианты доказаны в Lean.'

      service = container 'auction-service' {
        technology 'Rust'
        description 'Hexagonal: адаптеры снаружи, домен внутри, домен не знает об инфраструктуре.'
        icon tech:rust

        api = component 'HTTP adapter' {
          description 'Входящие команды. JWT уже проверен мешем, отсюда берём user_id.'
        }

        aggregate = component 'Auction aggregate' {
          #domain
          description '''
            Английский аукцион с proxy bidding (ADR-0009).
            Инварианты:
            - цена не убывает
            - лидер держит наибольший максимум
            - цена ≤ второй максимум + шаг
            - победитель платит не больше своего максимума
            - аукцион завершается ровно один раз
          '''

          policy = component 'Pricing policy' {
            #domain
            description '''
              Доменная политика внутри агрегата, не доменный сервис: работает только над состоянием этого аукциона.
              Чистая функция (максимумы, шаг) → (лидер, цена). Без планировщика.
            '''
          }
        }

        events = component 'Domain events' {
          #domain
          description '''
            Приватные: AuctionOpened, MaxBidPlaced(user, max), AuctionClosed, WinnerDetermined.
            Публичная проекция: PriceChanged(price, leader, version). Максимумы наружу не выходят.
          '''
        }

        eventstore = component 'Event store' {
          description 'Append-only журнал событий, версия потока = optimistic lock. Строка outbox пишется в той же транзакции.'
        }

        outbox = component 'Outbox relay' {
          description 'Читает таблицу outbox той же БД, публикует в брокер. At-least-once, помечает отправленное.'
        }

        consumer = component 'Event consumer' {
          description 'LotListed из Catalog → команда OpenAuction'
        }

        history = component 'Event history query' {
          description 'GET events?since=<version>. Только публичная проекция PriceChanged. Нужен BFF для дозапроса после переподключения SSE.'
        }
      }

      db = database 'auction-db' {
        technology 'PostgreSQL'
        description 'Журнал событий + outbox + проекции. Принадлежит только auction-service.'
      }
    }

    // ----- Bounded context: Catalog -----

    catalog = context 'Catalog' {
      #domain
      description 'Описание лотов: название, фото, категория. Read-heavy, без торговой логики.'

      service = container 'catalog-service' {
        technology 'Rust'
        description 'CRUD лотов, поиск, выдача карточек.'
        icon tech:rust

        api = component 'HTTP adapter'
        lot = component 'Lot' {
          #domain
          description 'Агрегат лота. Событие LotListed запускает торги.'
        }
        repository = component 'Lot repository'
        outbox = component 'Outbox relay' {
          description 'LotListed → брокер, в одной транзакции с сохранением лота'
        }
      }

      db = database 'catalog-db' {
        technology 'PostgreSQL'
        description 'Лоты и медиа-ссылки. Принадлежит только catalog-service.'
      }
    }

    // ----- Bounded context: Analytics -----

    analytics = context 'Analytics' {
      description 'Аналитическая история торгов. Только публичные неизменяемые события, eventually consistent (ADR-0010).'

      clickhouse = database 'ClickHouse' {
        technology 'ClickHouse'
        description 'Колоночное хранилище. Движок Kafka/NATS читает брокер в MaterializedView, отдельного consumer нет.'
        style {
          icon none
        }
      }
    }

    // ----- Инфраструктура -----

    broker = container 'Message broker' {
      #candidate
      technology 'NATS JetStream / Kafka — не решено'
      description 'Доставка событий между контекстами. Источник — outbox каждого сервиса.'
    }

    otel = container 'OTel Collector' {
      technology 'OpenTelemetry Collector'
      description 'Принимает OTLP от сервисов и меша, отправляет в Grafana stack.'
      icon tech:opentelemetry-icon
    }
  }

  // ---------- Связи ----------
  // Направление связей = направление чтения: сверху вниз, слева направо.

  bidder -> gavel.web 'смотрит лоты, делает ставки'
  seller -> gavel.web 'выставляет лоты'

  gavel.web -> idp 'логин по OAuth, получает JWT'

  gavel.web -> gavel.bff.routes 'REST, Bearer JWT' {
    technology 'HTTPS'
  }
  gavel.web -> gavel.bff.sse 'подписка на лот, получает новую цену' {
    technology 'SSE'
  }

  // BFF: компоновка и перевод, без доменных правил
  gavel.bff.routes -> gavel.bff.composer 'экран лота'
  gavel.bff.routes -> gavel.auction.service.api 'PlaceBid, CloseAuction'
  gavel.bff.routes -> gavel.catalog.service.api 'ListLot, UpdateLot'
  gavel.bff.composer -> gavel.catalog.service.api 'карточка лота'
  gavel.bff.composer -> gavel.auction.service.history 'цена, ставки'
  gavel.bff.sse -> gavel.auction.service.history 'replay since version'

  // Auction: команда → агрегат → события → журнал → БД; SSE и outbox читают зафиксированное
  gavel.auction.service.api -> gavel.auction.service.aggregate 'команды: PlaceBid(max), CloseAuction'
  gavel.auction.service.consumer -> gavel.auction.service.aggregate 'OpenAuction'
  gavel.auction.service.aggregate -[emits]-> gavel.auction.service.events 'emits'
  gavel.auction.service.events -> gavel.auction.service.eventstore 'append, expected version'
  gavel.auction.service.eventstore -[writes]-> gavel.auction.db 'events + outbox, одна транзакция'
  gavel.auction.service.eventstore -> gavel.auction.service.history 'чтение потока'
  gavel.auction.service.eventstore -> gavel.auction.service.outbox 'новые строки outbox (LISTEN/NOTIFY + poll)'
  gavel.auction.service.outbox -> gavel.broker 'publish'

  // Catalog
  gavel.catalog.service.api -> gavel.catalog.service.lot 'команды: ListLot, UpdateLot'
  gavel.catalog.service.lot -> gavel.catalog.service.repository 'save / load'
  gavel.catalog.service.repository -[writes]-> gavel.catalog.db 'lot + outbox, одна транзакция'
  gavel.catalog.service.repository -> gavel.catalog.service.outbox 'новые строки outbox (LISTEN/NOTIFY + poll)'
  gavel.catalog.service.outbox -> gavel.broker 'LotListed'

  // Между сервисами — только через брокер. Стрелка = зависимость: подписчик -> брокер.
  gavel.auction.service.consumer -> gavel.broker 'subscribe: LotListed'
  gavel.bff.sse -> gavel.broker 'subscribe: PriceChanged, AuctionClosed'

  // Analytics: читает публичные события прямо из брокера
  gavel.analytics.clickhouse -> gavel.broker 'subscribe: PriceChanged, AuctionOpened, AuctionClosed, LotListed' {
    technology 'Kafka / NATS engine'
  }
  gavel.bff.composer -> gavel.analytics.clickhouse 'график цены лота' {
    description 'Не на горячем пути: отставание на секунды допустимо'
  }
  observability -> gavel.analytics.clickhouse 'дашборды торгов' {
    technology 'Grafana ClickHouse datasource'
  }

  // Телеметрия
  gavel.bff -[exports]-> gavel.otel 'OTLP/gRPC'
  gavel.auction.service -[exports]-> gavel.otel 'OTLP/gRPC'
  gavel.catalog.service -[exports]-> gavel.otel 'OTLP/gRPC'
  gavel.otel -[exports]-> observability 'OTLP'
}
