views {

  // ---------- C1 ----------

  view index {
    title 'C1. System Context'
    description 'Gavel как чёрный ящик: кто им пользуется и от чего он зависит'
    include bidder, seller, gavel, idp, observability
    autoLayout TopBottom
  }

  // ---------- C2 ----------

  view containers of gavel {
    title 'C2. Containers'
    description 'Деплоимые единицы. Bounded context = группа: сервис + своя БД. Вход только через BFF.'
    include
      bidder, seller,
      *,
      gavel.auction.*, gavel.catalog.*, gavel.analytics.*,
      idp, observability
    exclude gavel.otel, observability -> gavel
    autoLayout TopBottom
  }

  // ---------- C3 ----------

  view bff of gavel.bff {
    title 'C3. Components — BFF'
    description 'Сверху вниз: Web UI → routes → composer / SSE → доменные сервисы и аналитика'
    include
      gavel.web,
      gavel.broker,
      *,
      gavel.auction.service, gavel.catalog.service, gavel.analytics.clickhouse
    exclude gavel.otel
    autoLayout TopBottom
  }

  view auction of gavel.auction {
    title 'C3. Components — Auction'
    description 'Сверху вниз: BFF → адаптер → агрегат → события → журнал → БД'
    include
      gavel.bff,
      gavel.broker,
      *,
      gavel.auction.service.*,
      gavel.auction.service.aggregate.*
    exclude gavel.otel, gavel.catalog.service
    autoLayout TopBottom
  }

  view catalog of gavel.catalog {
    title 'C3. Components — Catalog'
    description 'Сверху вниз: BFF → адаптер → домен → репозиторий → БД'
    include
      gavel.bff,
      *,
      gavel.catalog.service.*,
      gavel.broker
    exclude gavel.otel, gavel.auction.service
    autoLayout TopBottom
  }

  view analytics of gavel.analytics {
    title 'C3. Analytics — поток в ClickHouse'
    description 'Публичные события из outbox через брокер в ClickHouse, дальше Grafana и график в BFF'
    include
      gavel.auction.service, gavel.catalog.service,
      gavel.broker,
      *,
      gavel.bff, observability
    exclude gavel.otel
    autoLayout TopBottom
  }

  // ---------- Сквозное ----------

  view observability of gavel {
    title 'Телеметрия'
    description 'Путь traces / metrics / logs от сервисов до Grafana'
    include
      gavel.bff,
      gavel.auction.service,
      gavel.catalog.service,
      gavel.otel,
      observability
    autoLayout LeftRight
  }

  // ---------- Deployment ----------

  deployment view prod {
    title 'Production — Kubernetes'
    description 'Сверху вниз: вход → приложение → данные. Sidecar-ы и меш — в отдельном виде.'
    include
      prod.k8s.istioSystem.*,
      prod.k8s.webNs.*,
      prod.k8s.bffNs.*,
      prod.k8s.auctionNs.*,
      prod.k8s.catalogNs.*,
      prod.k8s.messagingNs.*,
      prod.k8s.analyticsNs.*,
      prod.k8s.argocdNs.*,
      prod.idpInst
    exclude
      prod.k8s.webNs.webPod.envoy,
      prod.k8s.bffNs.bffPod.envoy,
      prod.k8s.auctionNs.auctionPod.envoy,
      prod.k8s.catalogNs.catalogPod.envoy
    autoLayout TopBottom
  }

  deployment view prod_mesh {
    title 'Production — Istio mesh и телеметрия'
    description 'Что делает меш на пути запроса и куда уходят span-ы'
    include
      prod.k8s.istioSystem.*,
      prod.k8s.bffNs.bffPod,
      prod.k8s.bffNs.bffPod.*,
      prod.k8s.auctionNs.auctionPod,
      prod.k8s.auctionNs.auctionPod.*,
      prod.k8s.obsNs.*,
      prod.grafanaInst
    autoLayout TopBottom
  }
}
