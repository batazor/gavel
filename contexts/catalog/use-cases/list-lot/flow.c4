// Диаграмма юзкейса. Модель — в docs/architecture/model.c4.
views {

  dynamic view flow_list_lot {
    title 'Выставить лот и открыть торги'
    description 'Catalog → outbox → брокер → Auction. Между контекстами только события.'
    autoLayout TopBottom

    seller -> gavel.web 'новый лот'
    gavel.web -> gavel.bff.graphql 'mutation listLot(input)'
    gavel.bff.graphql -> gavel.catalog.service.api 'ListLot'
    gavel.catalog.service.api -> gavel.catalog.db 'claim HMAC command receipt'
    gavel.catalog.service.api -> gavel.authz.service.check 'platform:gavel#create_lot; causal token + deadline'
    gavel.catalog.service.api -> gavel.authz.service.relationships 'atomic TOUCH lot:platform + lot:seller'
    gavel.catalog.service.api -> gavel.catalog.service.mediaAsset 'validate owner + READY; attach image ids'
    gavel.catalog.service.api -> gavel.catalog.service.lot 'validate'
    gavel.catalog.service.lot -> gavel.catalog.service.repository 'save lot + attached images'
    gavel.catalog.service.repository -> gavel.catalog.db 'lot + ATTACHED images + outbox(LotListed), одна транзакция'
    gavel.catalog.service.api -> gavel.authz.service.relationships 'reconciliation delete only after proof-of-absence' {
      notes 'Lease + stable idempotency key; existing lot protects its grant'
    }
    gavel.catalog.service.api -> gavel.bff.graphql 'Lot {id}'
    gavel.bff.graphql -> gavel.web 'GraphQL result'

    gavel.cdc -> gavel.catalog.db 'capture outbox from WAL'
    gavel.cdc -> gavel.broker 'publish LotListed'
    gavel.broker -> gavel.auction.service.consumer 'LotListed' {
      notes 'At-least-once: consumer идемпотентен по lot_id'
    }
    gavel.auction.service.consumer -> gavel.auction.service.aggregate 'OpenAuction(lot_id, start_price, ends_at)'
    gavel.auction.service.aggregate -> gavel.auction.service.events 'AuctionOpened'
    gavel.auction.service.events -> gavel.auction.service.eventstore 'append, version 1'
    gavel.auction.service.eventstore -> gavel.auction.db 'commit'
    gavel.catalog.service -[exports]-> gavel.otel 'bounded operation/outcome telemetry; ids/tokens/keys redacted'
  }
}
