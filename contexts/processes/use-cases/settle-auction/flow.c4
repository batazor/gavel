// Диаграмма юзкейса. Модель — в docs/architecture/model.c4.
views {

  dynamic view flow_payment {
    title 'Оплата и переход к следующему кандидату'
    description 'Temporal оркестрирует попытку, двухчасовое recovery и следующий раунд; Payments скрывает конкретного провайдера.'
    autoLayout TopBottom

    gavel.cdc -> gavel.auction.db 'capture restricted auction_process_outbox from WAL'
    gavel.cdc -> gavel.broker 'SettlementCandidateSelected(auction, candidate, amount, round) → ACL-protected process topic'
    gavel.broker -> gavel.processes.subscriber 'restricted SettlementCandidateSelected'
    gavel.processes.subscriber -> gavel.processes.settle 'signal-with-start SettleAuction on settle-auction-v1; owner_event'
    gavel.processes.subscriber -> gavel.broker 'durable acceptance → manual offset commit' {
      notes 'Transient Temporal failure leaves offset uncommitted; invalid record is committed only after sanitized quarantine publish'
    }
    gavel.processes.settle -> gavel.processes.activities 'NotifyCandidate'
    gavel.processes.activities -> gavel.notify.service.api 'gRPC SendNotification(candidate selected)'
    gavel.processes.settle -> gavel.processes.activities 'AttemptPayment'
    gavel.processes.activities -> gavel.payments.service.api 'gRPC AttemptPayment(auction, round, user, amount)'
    gavel.payments.service.api -> gavel.payments.service.payment 'durable PaymentAttemptStarted до provider effect'
    gavel.payments.service.payment -> gavel.payments.service.providerAdapter 'Charge' {
      notes 'idempotency-key = settlement:{auction_id}:{round}'
    }
    gavel.payments.service.providerAdapter -> stripe 'provider-specific charge'
    stripe -> cloudflare 'signed provider callback'
    cloudflare -> gavel.payments.service.webhook 'no-cache callback route via Tunnel/Istio'
    gavel.payments.service.webhook -> gavel.payments.service.payment 'Succeeded | RecoveryRequired | Processing'
    gavel.payments.service.repository -> gavel.payments.db 'attempt + outbox, одна транзакция'

    gavel.cdc -> gavel.payments.db 'capture payments outbox from WAL'
    gavel.cdc -> gavel.broker 'PaymentSucceeded | PaymentRecoveryRequired | PaymentExpired'
    gavel.broker -> gavel.processes.subscriber 'payments attempt event from restricted topic'
    gavel.processes.subscriber -> gavel.processes.settle 'owner_event(PaymentChanged version)'
    gavel.processes.settle -> gavel.processes.activities 'GetSettlementAttempt before transition'
    gavel.processes.activities -> gavel.payments.service.api 'authoritative read(expected auction + round)'
    gavel.processes.settle -> gavel.processes.activities 'PaymentRecoveryRequired: send recovery email'
    gavel.processes.activities -> gavel.notify.service.api 'gRPC SendNotification(recovery URL)'
    gavel.notify.service.channelAdapter -> emailProvider 'send recovery email'
    emailProvider -> bidder 'payment recovery link'
    bidder -> gavel.web 'open recovery'
    gavel.web -> gavel.bff.graphql 'mutation continuePayment(attemptId)'
    gavel.bff.graphql -> gavel.payments.service.api 'ContinuePayment'
    gavel.web -> stripe 'provider-hosted recovery'
    gavel.processes.settle -> gavel.processes.activities 'через 2ч: ExpirePayment'
    gavel.processes.activities -> gavel.payments.service.api 'gRPC ExpirePayment; provider query/cancel; success wins'
    gavel.processes.settle -> gavel.processes.activities 'после PaymentExpired: ForfeitSettlementCandidate'
    gavel.processes.activities -> gavel.auction.service.api 'gRPC ForfeitCandidate(user, round)'
    gavel.auction.service.api -> gavel.auction.service.aggregate 'exclude + recalculate'
    gavel.processes.settle -> gavel.processes.activities 'после authoritative forfeiture: NotifyCandidateFailed'
    gavel.processes.activities -> gavel.notify.service.api 'gRPC SendNotification(candidate failed, auction_id)'
    gavel.auction.service.aggregate -> gavel.auction.service.events 'SettlementCandidateSelected(next, new_amount) | AuctionUnsold' {
      notes 'Settlement amount пересчитана без максимума выбывшего; closing price не меняется'
    }
    gavel.processes.settle -> gavel.processes.activities 'WinnerConfirmed: NotifyWinner'
    gavel.processes.activities -> gavel.notify.service.api 'gRPC SendNotification(winner confirmed)'
  }
}
