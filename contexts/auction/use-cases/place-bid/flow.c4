// Диаграмма юзкейса. Модель — в docs/architecture/model.c4.
views {

  dynamic view flow_place_bid {
    title 'Ставка'
    description 'От нажатия кнопки до обновления цены у всех подписчиков'
    autoLayout TopBottom

    bidder -> gavel.web 'ставка: максимум 120'
    gavel.web -> gavel.bff.graphql 'mutation placeBid(id, amount, idempotencyKey)'
    gavel.bff.graphql -> gavel.auction.service.api 'PlaceBid(user_id, amount)'
    gavel.auction.service.api -> gavel.auction.service.api 'derive stable bid_id(user, auction, key)' {
      notes 'Серверное время не входит в canonical fingerprint; exact retry получает тот же bid_id'
    }
    gavel.auction.service.api -> gavel.auction.db 'lookup idempotency key + request fingerprint' {
      notes 'Тот же request → stored result без нового события; другой payload → IDEMPOTENCY_CONFLICT'
    }
    gavel.auction.service.api -> gavel.authz.service.check 'authoritative auction#place_bid, deadline, fail-closed'
    gavel.auction.service.api -> gavel.auction.db 'check PaymentInstrumentReady projection' {
      notes 'Нет готового способа оплаты → PAYMENT_METHOD_REQUIRED'
    }
    gavel.auction.service.api -> gavel.auction.service.aggregate 'load + PlaceBid'
    gavel.auction.service.aggregate -> gavel.auction.service.events 'MaxBidPlaced + BidRecorded; PriceChanged and restricted BidderOutbid if needed' {
      notes 'Auction authoritative определяет outbid recipient; maximum и новый leader не выходят в integration contracts'
    }
    gavel.auction.service.events -> gavel.auction.service.eventstore 'append, expected version = N'
    gavel.auction.service.eventstore -> gavel.auction.db 'events + public projection + safe outbox + command result, одна транзакция' {
      notes 'Конфликт версии → bounded retry сервиса на свежем stream; exhaustion → retryable CONTENTION'
    }
    gavel.auction.service.api -> gavel.bff.graphql 'PlaceBidResult, version N+1'
    gavel.bff.graphql -> gavel.web 'GraphQL result'

    gavel.cdc -> gavel.auction.db 'capture outbox from WAL'
    gavel.cdc -> gavel.broker 'publish BidRecorded + optional PriceChanged to gavel.auction.public.v1'
    gavel.cdc -> gavel.broker 'publish BidderOutbid to restricted gavel.auction.processes.v1'
    gavel.broker -> gavel.processes.activities 'durable outbid intent'
    gavel.processes.activities -> gavel.notify.service.api 'SendNotification(bidder_outbid.v1)'
    gavel.broker -> gavel.realtime.subscription 'PriceChanged'
    gavel.bff.graphql -> gavel.web 'subscription: price, version: N+1' {
      notes 'Все подписчики лота, включая автора ставки'
    }
  }
}
