// Диаграмма юзкейса. Модель — в docs/architecture/model.c4.
views {

  dynamic view flow_subscription_reconnect {
    title 'Переподключение GraphQL subscription'
    description 'afterVersion = версия Auction stream. Realtime subgraph восстанавливает terminal events и актуальную цену; промежуточные цены hot lot можно coalesce.'
    autoLayout TopBottom

    gavel.web -> gavel.bff.graphql 'subscription auctionUpdates(id, afterVersion: 7)' {
      notes 'Клиент хранит последнюю применённую версию и переподписывается после разрыва'
    }
    gavel.bff.graphql -> gavel.realtime.subscription 'start subscription'
    gavel.realtime.subscription -> gavel.auction.service.history 'events since version 7'
    gavel.auction.service.history -> gavel.auction.service.eventstore 'read stream from 8'
    gavel.auction.service.eventstore -> gavel.auction.db 'select'
    gavel.auction.service.history -> gavel.realtime.subscription '[8, 9]'
    gavel.bff.graphql -> gavel.web 'replay: version 8, version 9' {
      notes 'Затем живой поток из брокера через тот же subscription interface'
    }
    gavel.realtime.subscription -> gavel.broker 'subscribe auction id'
    gavel.bff.graphql -> gavel.web 'closed | paid: public invalidation signal'
    gavel.web -> gavel.bff.graphql 'query lot(id) { viewer { isSettlementCandidate isWinner } }'
    gavel.bff.graphql -> gavel.web 'viewer capabilities' {
      notes 'Winner только после PaymentSucceeded → WinnerConfirmed'
    }
  }
}
