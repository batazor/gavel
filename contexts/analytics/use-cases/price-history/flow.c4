// Диаграмма юзкейса. Модель — в docs/architecture/model.c4.
views {

  dynamic view flow_analytics {
    title 'Событие попадает в аналитику'
    description 'Без consumer-сервиса: ClickHouse сам читает брокер. Горячий путь ставки от этого не зависит.'
    autoLayout TopBottom

    gavel.cdc -> gavel.auction.db 'capture public outbox from WAL'
    gavel.cdc -> gavel.broker 'publish PriceChanged(160, v9)'
    gavel.broker -> gavel.analytics.clickhouse 'Kafka engine → MaterializedView' {
      notes 'Батчи, async insert. Отставание секунды'
    }
    observability -> gavel.analytics.clickhouse 'дашборд: средняя цена закрытия по категориям'
    gavel.analytics.service.api -> gavel.analytics.clickhouse 'график цены лота за всё время'
    gavel.bff.graphql -> gavel.web 'скомпонованный Lot с графиком' {
      notes 'Текущая цена при этом идёт из Auction, а не из ClickHouse'
    }
  }
}
